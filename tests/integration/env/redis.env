# Point the cache 'redis' store at the throwaway redis container (offset port
# 56379 to avoid clashing with any local redis) so the redis cache backend is
# exercised end-to-end against a real server.  CACHE_STORE=redis also makes the
# app's DEFAULT cache store redis for the duration of the run.
#
# REDIS_CACHE_* drives the 'cache' redis connection used by the redis cache store;
# REDIS_APP1_* keeps the general-purpose 'app1' redis connection pointed at the
# same container.  Both are defined in tests/apps/app1/config/database.py.
CACHE_STORE=redis

REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=56379
REDIS_CACHE_DB=2

REDIS_APP1_HOST=127.0.0.1
REDIS_APP1_PORT=56379
REDIS_APP1_DB=0
