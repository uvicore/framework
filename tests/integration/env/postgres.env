# Point BOTH the app1 and auth connections at the same Postgres database so they
# share one metakey (and one metadata space), exactly like the SQLite :memory: default.
DB_APP1_DIALECT=postgresql
DB_APP1_HOST=127.0.0.1
DB_APP1_PORT=55432
DB_APP1_DB=uvicore
DB_APP1_USER=uvicore
DB_APP1_PASSWORD=techie

DB_AUTH_DIALECT=postgresql
DB_AUTH_HOST=127.0.0.1
DB_AUTH_PORT=55432
DB_AUTH_DB=uvicore
DB_AUTH_USER=uvicore
DB_AUTH_PASSWORD=techie
