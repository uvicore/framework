{% extends "layouts/app.j2" %}

{% block title %}{{ site_name }} &middot; Admin{% endblock %}

{% block content %}
<section class="page-head">
  <h1>Admin</h1>
  <p class="lead">Guarded page - reached only with the <code>authenticated</code> scope.
     Below is the injected <code>request.user</code> (UserInfo).</p>
</section>

<table class="kv">
  <tbody>
    <tr><th>Name</th><td>{{ user.name }}</td></tr>
    <tr><th>Username</th><td>{{ user.username }}</td></tr>
    <tr><th>Email</th><td>{{ user.email }}</td></tr>
    <tr><th>Authenticated</th><td>{{ user.authenticated }}</td></tr>
    <tr><th>Is admin</th><td>{{ user.is_admin }}</td></tr>
    <tr><th>Can posts.read</th><td>{{ user.can('posts.read') }}</td></tr>
    <tr><th>Groups</th><td>{{ user.groups }}</td></tr>
    <tr><th>Roles</th><td>{{ user.roles }}</td></tr>
    <tr><th>Permissions</th><td>{{ user.permissions }}</td></tr>
  </tbody>
</table>
{% endblock %}
