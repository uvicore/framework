{#
  Base layout shared by every app1 page.

  Child pages do:  {% extends "layouts/app.j2" %}  and override the blocks below.
  Site-wide context (site_name, nav, year, ...) is injected by the Layout view
  composer (app1/*), so pages don't have to pass it.  Static assets are referenced
  through the framework asset()/public() context functions.
#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site_name }}{% endblock %}</title>
  <link rel="icon" href="{{ public('favicon.ico') }}">
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  {% block head %}{% endblock %}
</head>
<body>
  {% include "partials/header.j2" %}

  <div class="container layout {% block layout_class %}{% endblock %}">
    <main class="content">
      {% block content %}{% endblock %}
    </main>
    {% block sidebar %}{% endblock %}
  </div>

  {% include "partials/footer.j2" %}

  <script src="{{ asset('js/app.js') }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
